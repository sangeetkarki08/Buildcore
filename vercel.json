{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "engine/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__p=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=/api/:path*"
    },
    {
      "source": "/files/:path*",
      "destination": "/api/index?__p=/files/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "framework": null
}
