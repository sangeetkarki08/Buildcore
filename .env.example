# BuildCore — Supabase configuration
#
# The browser app reads its config from js/supabase-config.js
# (copy js/supabase-config.example.js). This .env file documents the
# same values for the Supabase CLI / CI and any future tooling.
#
# Project Settings -> API in the Supabase dashboard.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side only — NEVER expose in the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Used by `supabase link`
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
