# BuildCore web - settings. Put these in Vercel: Project > Settings > Environment Variables.
# (For trying it on your own computer, copy this file to .env and fill it in. Never commit .env.)

# Supabase > your project > Connect (top bar) > "Session pooler" > URI. Replace [YOUR-PASSWORD] with the
# database password you chose when you created the project. Port 5432. Do NOT use the "Transaction pooler"
# string (port 6543): BuildCore refuses it.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API Keys. The project URL, and the service_role key
# (tab "Legacy API keys", the one marked secret). This key is only used by the server, never sent to browsers.
SUPABASE_URL=https://abcdefghijklmnop.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Any words you choose. Asked once, when the first administrator is created, so that nobody else who
# finds your web address first can make themselves administrator.
BCO_SETUP_KEY=choose-some-secret-words

# Optional: the private Storage bucket for photos, documents and backups (created automatically).
# BCO_STORAGE_BUCKET=buildcore-files
